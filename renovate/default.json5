// Política de versões da Welt Studio: a única declaração, herdada por todo projeto com
// `"extends": ["github>welt-studio/lint-configs//renovate/default"]` no `renovate.json`.
// Sem tag de propósito: a política nova vale para todos no merge aqui.
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
    ':enablePreCommit',
    // Actions fixadas por SHA, com a versão num comentário ao lado: uma tag pode ser movida, um SHA não.
    'helpers:pinGitHubActionDigests',
    // Um PR por projeto com tudo que não é major; cada major vem no seu, para revisão.
    'group:allNonMajor',
  ],

  // Uma rodada por mês, na madrugada do dia 1. Correção de vulnerabilidade não espera o calendário:
  // o `vulnerabilityAlerts` (padrão do Renovate) abre o PR na hora, sem a idade mínima abaixo.
  timezone: 'America/Sao_Paulo',
  schedule: ['* 0-6 1 * *'],
  lockFileMaintenance: {
    enabled: true,
    schedule: ['* 0-6 1 * *'],
  },

  // A versão mais nova com pelo menos 7 dias de publicada. Versão sem data no registro fica retida.
  // A trava do pnpm (`minimumReleaseAge` do `pnpm-workspace.yaml`) continua valendo na instalação.
  minimumReleaseAge: '7 days',

  // O próprio Renovate faz o merge, e só com todos os checks do PR verdes. O merge nativo do GitHub
  // fica desligado porque os repositórios não têm proteção de branch para segurá-lo; e PR sem
  // nenhum check nunca entra sozinho (sem `ignoreTests`).
  platformAutomerge: false,

  packageRules: [
    {
      description: 'Patch, minor e manutenção do lockfile entram sozinhos quando a CI passa.',
      matchUpdateTypes: ['minor', 'patch', 'pin', 'digest', 'lockFileMaintenance'],
      automerge: true,
    },
    {
      description: 'Minor do Python (3.14 → 3.15) é decisão do PO: depende de wheel das dependências pesadas (torch).',
      matchDepNames: ['python'],
      matchUpdateTypes: ['minor', 'major'],
      groupName: 'Python',
      automerge: false,
    },
    {
      description: 'Major de Node e pnpm vêm juntos em todos os lugares do projeto, para revisão.',
      matchDepNames: ['node', 'pnpm'],
      matchUpdateTypes: ['major'],
      groupName: '{{depName}} major',
      automerge: false,
    },
    {
      description: 'Os padrões deste repo têm uma tag por pacote: o hook `ruff-base` só olha as `ruff-v*`.',
      matchPackageNames: ['welt-studio/lint-configs'],
      matchCurrentValue: '/^ruff-v/',
      versioning: 'regex:^ruff-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$',
    },
    {
      description: 'E o pacote ESLint só as `eslint-v*`.',
      matchPackageNames: ['welt-studio/lint-configs'],
      matchCurrentValue: '/^eslint-v/',
      versioning: 'regex:^eslint-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$',
    },
    {
      // Exceção: a v2.0.0 (2024) roda em Node 20, que o GitHub está tirando dos runners, e a migração
      // para Node 24 (rustsec/audit-check#48) ainda não tem tag. Fica no commit do `main` até sair
      // uma release; aí esta regra sai.
      description: 'rustsec/audit-check preso no commit do main até sair release em Node 24.',
      matchPackageNames: ['rustsec/audit-check'],
      enabled: false,
    },
    {
      // Fora do PR agrupado: a mudança vem sem o lockfile (ver o `customManagers`), e a CI do grupo
      // inteiro ficaria vermelha por ela. Rodar `pnpm install` no PR antes do merge.
      description: 'O pacote ESLint deste repo vem em PR próprio, para revisão.',
      matchDepNames: ['@welt-studio/eslint-config'],
      groupName: '@welt-studio/eslint-config',
      automerge: false,
    },
    {
      // Os `overrides` são correções de vulnerabilidade em dependência indireta, com faixa fechada de
      // propósito; o Renovate as levaria para a major mais nova do pacote.
      description: 'Overrides do pnpm são mantidos à mão, junto com o advisory que os criou.',
      matchDepTypes: ['pnpm.overrides', 'pnpm-workspace.overrides'],
      enabled: false,
    },
    {
      description: 'O GHCR não informa data de publicação: estas imagens andam pelo pacote (regras abaixo), com a idade mínima valendo.',
      matchDatasources: ['docker'],
      matchPackageNames: ['ghcr.io/pnpm/pnpm', 'ghcr.io/astral-sh/uv'],
      enabled: false,
    },
  ],

  // Versões que os gerenciadores do Renovate não leem sozinhos.
  customManagers: [
    {
      description: 'uv: `[tool.uv] required-version`, imagem do GHCR e a constante do instalador do nebulai.',
      customType: 'regex',
      managerFilePatterns: [
        '/(^|/)pyproject\\.toml$/',
        '/(^|/)[^/]*Dockerfile[^/]*$/',
        '/(^|/)scripts/[^/]+\\.m?js$/',
      ],
      matchStrings: [
        'required-version\\s*=\\s*"==(?<currentValue>\\d+\\.\\d+\\.\\d+)"',
        'ghcr\\.io/astral-sh/uv:(?<currentValue>\\d+\\.\\d+\\.\\d+)',
        'UV_VERSION\\s*=\\s*"(?<currentValue>\\d+\\.\\d+\\.\\d+)"',
      ],
      depNameTemplate: 'uv',
      datasourceTemplate: 'pypi',
    },
    {
      description: 'pnpm nas imagens do GHCR e no `ARG PNPM_VERSION` dos Dockerfiles.',
      customType: 'regex',
      managerFilePatterns: ['/(^|/)[^/]*Dockerfile[^/]*$/'],
      matchStrings: [
        'ghcr\\.io/pnpm/pnpm:(?<currentValue>\\d+\\.\\d+\\.\\d+)',
        'ARG PNPM_VERSION=(?<currentValue>\\d+\\.\\d+\\.\\d+)',
      ],
      depNameTemplate: 'pnpm',
      datasourceTemplate: 'npm',
    },
    {
      // O gerenciador npm não lê dependência do git com `&path:`. O lockfile não acompanha (gerenciador
      // por regex não roda o `pnpm install`), então este PR sempre pede revisão.
      description: 'O pacote ESLint deste repo, pela tag `eslint-v*`.',
      customType: 'regex',
      managerFilePatterns: ['/(^|/)package\\.json$/', '/(^|/)pnpm-workspace\\.yaml$/'],
      matchStrings: ['github:welt-studio/lint-configs#(?<currentValue>eslint-v\\d+\\.\\d+\\.\\d+)&path:/eslint'],
      depNameTemplate: '@welt-studio/eslint-config',
      packageNameTemplate: 'welt-studio/lint-configs',
      datasourceTemplate: 'github-tags',
      versioningTemplate: 'regex:^eslint-v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$',
    },
    {
      description: 'Ferramentas rodadas fora do lock do projeto: `uvx <nome>@<versão>`.',
      customType: 'regex',
      managerFilePatterns: ['/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/', '/(^|/)Makefile$/', '/\\.sh$/'],
      matchStrings: ['uvx (?<depName>[A-Za-z0-9_.-]+)@(?<currentValue>\\d+(?:\\.\\d+)+)'],
      datasourceTemplate: 'pypi',
    },
  ],
}
